---
import { sponsors } from '../data/site';
---

<ul class="list-reset sponsor-grid">
  {sponsors.map((s) => <li class="card px">{s}</li>)}
  <li><a href="/sponsors/" class="mono add">+ jouw logo hier</a></li>
</ul>

<style>
  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 760px) {
    .sponsor-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
  .sponsor-grid > li {
    min-height: 96px;
  }
  .card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    font-size: clamp(18px, 2vw, 22px);
    text-align: center;
  }
  .add {
    height: 100%;
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    border: 2px dashed var(--yellow);
    text-decoration: none;
  }
</style>
