---
import Base from '../layouts/Base.astro';
---

<Base title="Bericht verstuurd" description="Je bericht is verstuurd." noindex>
  <section class="wrap section stack" style="--stack: 22px; max-width: 760px">
    <p class="tag">&gt; send --to team — 200 OK</p>
    <h1 class="px block h1">Bericht ontvangen!</h1>
    <p class="lead">Bedankt. We lezen alles zelf en nemen zo snel mogelijk contact met je op.</p>
    <div class="row">
      <a href="/" class="btn">Terug naar home</a>
      <a href="/#robot" class="btn ghost">Bekijk Porcupine</a>
    </div>
  </section>
</Base>
