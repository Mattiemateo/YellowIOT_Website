---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Afbeelding voor social previews, absoluut pad vanaf de root. */
  ogImage?: string;
  current?: string;
  cta?: { href: string; label: string; short: string };
  noindex?: boolean;
  /** Extra JSON-LD objecten voor deze pagina. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og.jpg',
  current,
  cta,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  '@id': `${site.url}/#team`,
  name: site.name,
  alternateName: [`FTC Team ${site.teamNumber}`, 'Yellow IoT', 'Team Yellow IOT'],
  url: `${site.url}/`,
  logo: `${site.url}/android-chrome-512x512.png`,
  email: site.email,
  sport: 'Robotica — FIRST Tech Challenge',
  memberOf: { '@type': 'SportsOrganization', name: 'FIRST Tech Challenge', url: 'https://www.firstinspires.org/robotics/ftc' },
  identifier: { '@type': 'PropertyValue', propertyID: 'FTC team number', value: site.teamNumber },
  sameAs: [site.linkedin, site.instagram],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B0B0C" />

    <Font cssVariable="--font-pixel" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-digits" />
    <Font cssVariable="--font-body" preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Samenvatting voor AI-agents" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">Naar inhoud</a>
    <Header current={current} cta={cta} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="end" />
    <script>
      import '../scripts/eggs';
    </script>
  </body>
</html>
